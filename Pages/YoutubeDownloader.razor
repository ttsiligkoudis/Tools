@page "/youtube-downloader"

<h3 class="d-lg-none mb-4">Youtube Downloader</h3>

<div class="container card shadow card-body">
    <div class="row">
        <div class="col-md-7 mb-2">
            <div class="form-switch">
                <input class="form-check-input" type="checkbox" @onchange="@PlaylistSwitchOnChange" disabled="@isLoading" />
                <label>Download Playlist</label>
            </div>
            <input @oninput="UrlOnInput" class="form-control" placeholder="Enter YouTube URL" />
        </div>

        <div class="col-md-3">
            <label>Export Type</label>
            <select class="form-select" @bind="selectedType" disabled="@isLoading">
                <option Value="@VideoType.Audio">Only Audio</option>
                <option Value="@VideoType.AudioMp3">Only Audio(Mp3)</option>
                <option Value="@VideoType.Video">Only Video</option>
                <option Value="@VideoType.VideoAndAudioQuick">Video & Audio(Quick download)</option>
                <option hidden="@isPlaylist" Value="@VideoType.VideoAndAudioHighestQuality">Video & Audio(Highest Quality)</option>
            </select>
        </div>

        <div class="col-md-2 mb-2">
            <div class="float-end">
                <label></label>
                <button @onclick="DownloadButtonClicked" disabled="@isLoading" class="d-block btn btn-primary">Download</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        if (showLoader)
        {
            <div class="d-flex justify-content-center mt-3">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else
        {
            <div class="progress mt-3" style="height: 30px">
                <div class="progress-bar" style="width: @($"{downloadProgress}%");" role="progressbar" aria-valuenow="@($"{downloadProgress}%")" aria-valuemin="0" aria-valuemax="100">@($"{downloadProgress}%")</div>
            </div>
        }
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            @errorMessage
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(thumbnailUrl) && !string.IsNullOrEmpty(title))
{
    <div class="d-flex justify-content-center mt-3">
        <div class="card col-sm-4">
            <img class="card-img-top" src="@thumbnailUrl" alt="@title">
            <div class="card-body">
                <h5 class="card-title">@title</h5>
            </div>
        </div>
    </div>

}
